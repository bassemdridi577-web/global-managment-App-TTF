generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  username String
  password String
  laboname String
}

model PvEssai {
  id                 Int       @id @default(autoincrement())
  marque             String?
  power              Float?
  frequency          Int?
  numero             String?
  phases             Int?
  type               String?
  client             String?
  mission            String?
  mtu1               Float?
  mtu2               Float?
  btu2               Float?
  prises             String?
  norme              String?
  couplage           String?
  matiere            String?
  refroidissement    String?
  bti2               Float?
  date               DateTime?
  voltage_ratio      Json?
  voltage_ratio_2    Json?
  no_load_test       Json?
  no_load_test_2     Json?
  short_circuit_test Json?
  dielectric_test    Json?
  resistance_test    Json?
  bitention_tests    Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  bti2_2             String?
  btu2_2             String?
  mti2_1             String?
  operateur          String?
  conformite         String?
  bitention          String?
  tensionType        String?
  list1              String?
  list2              String?
  list3              String?
  list4              String?
  mtU1_2             String?
  couplage2          String?
  mtu2_2             Float?
  
}

model Commande {
  id        Int      @id @default(autoincrement())
  numero    String?
  client    String?
  items     Json?
  total     Float?
  status    String?  @default("pending")
  formData  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}